enum UserRole {
    USER
    TEACHER
    ADMIN
}

input NewUserData {
    name: String!
    surname: String!
    nickName: String!
    role: UserRole!
    email: String!
    password: String!
}

input UserLoginData {
    email: String!
    password: String!
}

input UserVerifyData {
    email: String!
    code: String!
}

input ResetPasswordData {
    email: String!
    code: String!
    newPassword: String!
}

type LoginResult {
    token: String!
    refreshToken: String!
}

type RegisterPayload {
    registered: Boolean!
    verificationRequired: Boolean!
}

type VerifyUserPayload {
    verified: Boolean!
}

type ResetPasswordRequestPayload {
    requested: Boolean!
}

type ResetPasswordPayload {
    reset: Boolean!
}

type LogoutPayload {
    loggedOut: Boolean!
}

type Query {
    getAllUsers: [String!]!
}

type Mutation {
    register(userData: NewUserData!): RegisterPayload!
    login(userLoginData: UserLoginData!): LoginResult!
    refresh(refreshToken: String!): LoginResult!
    verifyUser(userVerifyData: UserVerifyData!): VerifyUserPayload!
    resetPasswordRequest(email: String!): ResetPasswordRequestPayload!
    resetPassword(resetPasswordData: ResetPasswordData!): ResetPasswordPayload!
    logout(refreshToken: String!): LogoutPayload!
}