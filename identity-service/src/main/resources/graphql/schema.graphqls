enum UserRole {
    ADMIN
    USER
    TEACHER
}

input NewUserData {
    name: String!
    surname: String!
    nickName: String!
    role: UserRole!
    email: String!
    password: String!
}

input UserLoginData {
    email: String!
    password: String!
}

input UserVerifyData {
    email: String!
    code: String!
}

input ResetPasswordData {
    email: String!
    code: String!
    newPassword: String!
}

type LoginResult {
    token: String!
    refreshToken: String!
}

type Query {
    getAllUsers: [String]
}

type Mutation {
    register(userData: NewUserData): Boolean
    login(userLoginData: UserLoginData): LoginResult
    refresh(refreshToken: String!): LoginResult
    verifyUser(userVerifyData: UserVerifyData): Boolean
    resetPasswordRequest(email: String!): Boolean
    resetPassword(resetPasswordData: ResetPasswordData): Boolean
    logout(refreshToken: String): Boolean
}