type WordData {
    id: ID!
    word: String!
    translation: String!
    insertDateTime: String!
    isLearned: Boolean!
    memorizeChance: Float!
}

type AddWordResult {
    created: Boolean!
    wordId: ID
    existingWordId: ID
}

type SetLearnedPayload {
    wordId: ID!
    isLearned: Boolean!
}

type UpdateWordPayload {
    wordId: ID!
    word: String!
    translation: String!
}

type DeleteWordPayload {
    deleted: Boolean!
    wordId: ID!
}

type WordTestResultPayload {
    wordId: ID!
    isCorrect: Boolean!
    testTime: String!
}

input InputWordData {
    word: String!
    translation: String!
    forceDuplicate: Boolean!
}

input SetLearnedInput {
    wordId: ID!
    isLearned: Boolean!
}

input UpdateWordInput {
    wordId: ID!
    word: String!
    translation: String!
}

type Query {
    getUserWords: [WordData!]!
}

type Mutation {
    addWord(input: InputWordData!): AddWordResult!
    testWord(wordId: ID!, translation: String!): WordTestResultPayload!
    setLearned(setLearnedInput: SetLearnedInput!): SetLearnedPayload!
    updateWord(input: UpdateWordInput!): UpdateWordPayload!
    deleteWord(wordId: ID!): DeleteWordPayload!
}