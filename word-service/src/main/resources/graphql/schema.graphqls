type WordData {
    word: String
    translation: String
    insertDateTime: String
}

type AddWordResult {
    created: Boolean!
    wordId: String
    existingWordId: String
}

input InputWordData {
    word: String!
    translation: String!
    forceDuplicate: Boolean!
}

type Query {
    getUserWords: [WordData]
}

type Mutation {
    addWord(input: InputWordData): AddWordResult
}