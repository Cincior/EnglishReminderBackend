type WordData {
    id: String!
    word: String!
    translation: String!
    insertDateTime: String!
    isLearned: Boolean!
}

type AddWordResult {
    created: Boolean!
    wordId: String
    existingWordId: String
}

input InputWordData {
    word: String!
    translation: String!
    forceDuplicate: Boolean!
}

input SetLearnedInput {
    wordId: String!
    isLearned: Boolean!
}

input UpdateWordInput {
    wordId: String!
    word: String!
    translation: String!
}

type Query {
    getUserWords: [WordData!]!
}

type Mutation {
    addWord(input: InputWordData!): AddWordResult!
    setLearned(setLearnedInput: SetLearnedInput!): Boolean!
    updateWord(input: UpdateWordInput!): Boolean!
    deleteWord(wordId: String!): Boolean!
}