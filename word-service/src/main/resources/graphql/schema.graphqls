type WordData {
    id: ID!
    word: String!
    translation: String!
    insertDateTime: String!
    memorizeChance: Float!
}

enum Category {
    LEARNED
    NOT_LEARNED
    LEARN_LATER
    LEARN_NOW
}

type AddWordResult {
    created: Boolean!
    wordId: ID
    existingWordId: ID
}

type SetCategoryPayload {
    wordId: ID!
    category: Category!
}

type UpdateWordPayload {
    wordId: ID!
    word: String!
    translation: String!
}

type DeleteWordPayload {
    deleted: Boolean!
    wordId: ID!
}

type WordTestResultPayload {
    wordId: ID!
    isCorrect: Boolean!
    testTime: String!
}

input InputWordData {
    word: String!
    translation: String!
    forceDuplicate: Boolean!
}

input SetCategoryInput {
    wordId: ID!
    category: Category!
}

input UpdateWordInput {
    wordId: ID!
    word: String!
    translation: String!
}

type Query {
    getUserWords: [WordData!]!
}

type Mutation {
    addWord(input: InputWordData!): AddWordResult!
    testWord(wordId: ID!, translation: String!): WordTestResultPayload!
    setCategory(setCategoryInput: SetCategoryInput!): SetCategoryPayload!
    updateWord(input: UpdateWordInput!): UpdateWordPayload!
    deleteWord(wordId: ID!): DeleteWordPayload!
}